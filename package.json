  "files": [
    "dist",
    "thumbnails",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "export:data": "node scripts/export-data.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.demo.json",
    "test": "node --test test/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm thumbnails && node scripts/check-package.ts",
    "test:package": "pnpm build && pnpm thumbnails && node scripts/check-package.ts",
    "prepublishOnly": "pnpm check",
    "site": "pnpm build && node scripts/site.ts",
    "dev": "pnpm site && node scripts/dev.ts",
    "test:demo": "pnpm site && node scripts/docs-site.mjs build && playwright test",
    "images": "node scripts/images.ts",
    "test:readme": "pnpm build && node scripts/check-readme-examples.ts",
    "family:readme": "node scripts/family-readme.mjs",
    "test:demo:one": "pnpm site && node scripts/docs-site.mjs build && playwright test",
    "test:usage": "pnpm site && node scripts/check-usage.ts",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "size": "node scripts/docs-site.mjs size",
    "check:standard": "node scripts/check-standard.mjs",
    "thumbnails": "node scripts/make-thumbnails.ts"
  },
  "devDependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@eslint/js": "^9.0.0",
    "@johnmorrisdotca/hata": "^1.8.0",
    "@johnmorrisdotca/kazoku-ui": "^0.24.0",
    "@johnmorrisdotca/kuni": "^1.5.0",
    "@johnmorrisdotca/wakusei-planets": "^0.20.0",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "marked": "^18.1.3",
    "pagefind": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.6",
    "vue": "^3.5.45",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
